{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "values": "<DVC_METRIC_DATA>",
    "name": "source"
  },
  "transform": [
    {
      "calculate": "toNumber(datum['<DVC_METRIC_X>'])",
      "as": "dvc_x"
    },
    {
      "calculate": "toNumber(datum['<DVC_METRIC_Y>'])",
      "as": "dvc_y"
    }
  ],
  "title": {
    "text": "<DVC_METRIC_TITLE>",
    "anchor": "middle"
  },
  "width": 400,
  "height": 300,
  "encoding": {
    "x": {
      "field": "dvc_x",
      "type": "quantitative",
      "title": "<DVC_METRIC_X_LABEL>"
    },
    "color": {
      "field": "method_label",
      "type": "nominal",
      "title": null
    },
    "strokeDash": {
      "field": "rev",
      "type": "nominal",
      "title": "Revision",
      "legend": {
        "symbolFillColor": "transparent",
        "symbolStrokeColor": "grey",
        "orient": "bottom-right",
        "titleOpacity": {
          "expr": "dvc_multi_rev ? 1 : 0"
        },
        "labelOpacity": {
          "expr": "dvc_multi_rev ? 1 : 0"
        },
        "symbolOpacity": {
          "expr": "dvc_multi_rev ? 1 : 0"
        },
        "fillColor": {
          "expr": "dvc_multi_rev ? '#ffffffcc' : null"
        },
        "strokeColor": {
          "expr": "dvc_multi_rev ? '#d0d0d0' : null"
        },
        "titleFontSize": {
          "expr": "dvc_multi_rev ? 12.375 : 0"
        },
        "labelFontSize": {
          "expr": "dvc_multi_rev ? 11.25 : 0"
        },
        "symbolSize": {
          "expr": "dvc_multi_rev ? 100 : 0"
        },
        "symbolStrokeWidth": {
          "expr": "dvc_multi_rev ? 2 : 0"
        },
        "padding": {
          "expr": "dvc_multi_rev ? 5 : 0"
        },
        "titleLimit": {
          "expr": "dvc_multi_rev ? 180 : 0"
        },
        "labelLimit": {
          "expr": "dvc_multi_rev ? 400 : 0"
        }
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "errorband",
        "extent": "stdev",
        "opacity": 0.25
      },
      "encoding": {
        "y": {
          "field": "dvc_y",
          "type": "quantitative",
          "title": "<DVC_METRIC_Y_LABEL>",
          "scale": {
            "zero": false
          }
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 60
        }
      },
      "encoding": {
        "y": {
          "field": "dvc_y",
          "type": "quantitative",
          "title": "<DVC_METRIC_Y_LABEL>",
          "scale": {
            "zero": false
          },
          "aggregate": "mean"
        }
      }
    }
  ],
  "params": [
    {
      "name": "dvc_multi_rev",
      "expr": "length(data('source')) > 1 && data('source')[0]['rev'] !== peek(pluck(data('source'), 'rev'))"
    }
  ],
  "config": {
    "font": "CMU Serif, Computer Modern, Latin Modern Roman, serif",
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 16.5,
      "labelOverlap": "greedy"
    },
    "axisX": {
      "tickCount": {
        "expr": "ceil(width / 60)"
      }
    },
    "title": {
      "fontSize": 19.5
    },
    "legend": {
      "labelFontSize": 11.25,
      "titleFontSize": 12.375,
      "labelLimit": 400,
      "orient": "top-left",
      "fillColor": "#ffffffcc",
      "strokeColor": "#d0d0d0",
      "offset": 4,
      "padding": 5,
      "cornerRadius": 3
    }
  }
}
